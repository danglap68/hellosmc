# Copy to .env for local development (dotenv loads it in development/test).
# ENV holds only secrets of external services and the infrastructure the app
# needs before it can reach its database. Everything else (OCR provider and
# model, confidence thresholds, duplicate window, Telegram group handling,
# image size, email sender, ...) is configured by admins under "Cài đặt".
# Never commit real secrets.

# --- Infrastructure ---------------------------------------------------------
# Production database. Development/test use the local PostgreSQL socket.
# DATABASE_URL=postgres://hellosmc:password@localhost:5432/hellosmc_production
REDIS_URL=redis://localhost:6379/0
# Production only: Rails secrets and the public host used in email links.
# RAILS_MASTER_KEY=
# APP_HOST=bill.example.com

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Required in production (webhook). Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# --- OCR providers (choose which one is used under "Cài đặt") ---------------
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Cloudflare R2 (private bucket) -----------------------------------------
# When set, R2 is used; otherwise development stores images on local disk.
# Production always requires R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# --- SMTP (password-reset emails) --------------------------------------------
# Required in production. In development they are only used when the Resend
# block in config/environments/development.rb is uncommented.
# Resend: SMTP_ADDRESS=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key re_...>.
# The sender ("Cài đặt" → Email) must be on a domain verified in Resend, or
# onboarding@resend.dev, which only delivers to the Resend account's own email.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
