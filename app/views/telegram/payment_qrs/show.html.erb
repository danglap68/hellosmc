<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Xác nhận tiền đi · SMC</title>
    <%= stylesheet_link_tag "tabler.min", "application" %>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <%= javascript_include_tag "payment_qr_mini_app", type: "module" %>
  </head>
  <body class="app-ui">
    <main class="container-sm py-3" style="max-width: 640px">
      <div class="mb-3"><span class="text-secondary">SMC · Tiền đi</span><h1 class="h2 mt-1">Xác nhận chuyển khoản</h1></div>
      <div id="payment-message" class="alert alert-info" role="status" aria-live="polite">Đang xác thực Telegram…</div>
      <section id="payment-details" class="card" hidden>
        <div class="card-body">
          <div id="payment-summary"></div>
          <form id="payment-form" class="mt-3">
            <label class="form-label" for="payment-amount">Số tiền chuyển (VND)</label>
            <input id="payment-amount" class="form-control" type="number" inputmode="numeric" min="1" max="9999999999999" step="1" required aria-describedby="payment-hint">
            <p id="payment-hint" class="form-hint">Nếu số tiền sai, nhập lại số đúng. Số tiền này chỉ dùng để tạo QR, không sửa số liệu bill.</p>
            <button id="payment-confirm" class="btn btn-primary w-100 mt-2" type="submit">Đúng — Tạo QR</button>
            <button id="payment-cancel" class="btn btn-outline-secondary w-100 mt-2" type="button">Hủy yêu cầu</button>
          </form>
          <div id="payment-result" class="mt-3 text-center" hidden>
            <div id="payment-image"></div>
            <p id="payment-confirmed-amount" class="fw-bold mt-2"></p>
            <p class="text-secondary small">Kiểm tra tên người nhận trong ứng dụng ngân hàng trước khi chuyển. QR chưa xác nhận tiền đã chuyển.</p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
