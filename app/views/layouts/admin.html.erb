<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('app.name')}" : t("app.name") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="app-ui admin-layout"
        data-controller="command-palette rejection"
        data-action="turbo:before-cache@document->rejection#close"
        data-command-palette-items-value="<%= command_palette_items.to_json %>"
        data-command-palette-labels-value="<%= command_palette_labels.to_json %>">
    <a href="#main-content" class="skip-link"><%= t("ui.skip_to_content") %></a>
    <div class="page">
      <aside class="navbar navbar-vertical navbar-expand-lg shell-sidebar" aria-label="<%= t("ui.main_navigation") %>"
             data-controller="shell-menu" data-action="click->shell-menu#backdrop keydown@document->shell-menu#escape">
        <div class="shell-sidebar-inner">
          <div class="shell-brand-row">
            <%= link_to admin_root_path, class: "shell-brand" do %>
              <span class="shell-mark">S</span>
              <span>
                <span class="shell-name"><%= t("app.name") %></span>
                <span class="shell-product"><%= t("navigation.product") %></span>
              </span>
            <% end %>
            <button class="navbar-toggler shell-toggler collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                    aria-controls="sidebar-menu" aria-expanded="false" aria-label="<%= t('navigation.toggle') %>"
                    data-shell-menu-target="toggle">
              <span class="navbar-toggler-icon"></span>
            </button>
          </div>

          <div class="collapse navbar-collapse shell-collapse" id="sidebar-menu" data-shell-menu-target="menu">
            <button type="button" class="shell-search" data-action="command-palette#open">
              <%= icon("search") %>
              <span><%= t("navigation.palette_placeholder") %></span>
              <kbd data-command-palette-target="hint">⌘K</kbd>
            </button>

            <div class="shell-scroll"
                 data-controller="nav-pins"
                 data-nav-pins-cookie-value="<%= SettingsNavHelper::NAV_PINS_COOKIE %>"
                 data-nav-pins-labels-value="<%= { pin: t("navigation.pin"), unpin: t("navigation.unpin"), pin_short: t("navigation.pin_short"), unpin_short: t("navigation.unpin_short") }.to_json %>">
              <% pinned = shell_pinned_items %>
              <section class="shell-pins" data-nav-pins-target="section">
                <div class="shell-label"><%= t("navigation.pinned") %></div>
                <p class="shell-pins-empty" data-nav-pins-target="empty" <%= "hidden" if pinned.any? %>><%= t("navigation.pins_empty") %></p>
                <nav class="shell-nav" aria-label="<%= t("navigation.pinned") %>" data-nav-pins-target="pinned">
                  <% pinned.each do |item| %>
                    <%= render "layouts/shell_nav_item", item: item %>
                  <% end %>
                </nav>
              </section>

              <div class="shell-label"><%= t("navigation.pages") %></div>
              <nav class="shell-nav" aria-label="<%= t("ui.main_navigation") %>" data-nav-pins-target="list">
                <% shell_main_items.each do |item| %>
                  <%= render "layouts/shell_nav_item", item: item %>
                <% end %>
              </nav>
            </div>

            <div class="shell-bottom">
              <%= settings_nav_link %>
              <div class="dropdown dropup shell-user">
                <button type="button" class="shell-user-trigger" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('navigation.account') %>">
                  <span class="shell-avatar"><%= current_user.display_name.first.upcase %></span>
                  <span class="shell-user-text">
                    <span class="shell-user-name"><%= current_user.display_name %></span>
                    <span class="shell-user-role"><%= current_user.role_name %></span>
                  </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end shell-user-menu">
                  <span class="dropdown-header"><%= current_user.email %></span>
                  <div class="dropdown-item-text"><%= render "layouts/theme_switcher" %></div>
                  <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item", form: { data: { turbo: false } } do %>
                    <%= icon("logout", "dropdown-item-icon") %> <%= t("navigation.logout") %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <div class="page-wrapper">
        <main class="page-body" id="main-content" tabindex="-1">
          <div class="container-xl">
            <% if settings_context? && settings_tabs.any? %>
              <div class="settings-page">
                <header class="settings-intro">
                  <div>
                    <h1><%= t("navigation.settings") %></h1>
                    <p><%= t("navigation.settings_description") %></p>
                  </div>
                </header>
                <nav class="settings-tabs" aria-label="<%= t("navigation.settings") %>">
                  <% settings_tabs.each do |tab| %>
                    <% current = tab[:key] == current_settings_tab&.dig(:key) %>
                    <%= link_to tab[:label], tab[:url], class: "settings-tab", aria: { current: ("page" if current) } %>
                  <% end %>
                </nav>
                <div class="settings-body">
                  <%= render "admin/shared/settings_nav" %>
                  <div class="settings-main">
                    <div class="settings-main-head">
                      <h2><%= content_for(:title) %></h2>
                      <% if content_for?(:actions) %>
                        <div class="btn-list"><%= yield :actions %></div>
                      <% end %>
                    </div>
                    <%= yield %>
                  </div>
                </div>
              </div>
            <% else %>
              <% unless content_for?(:bare_page) %>
                <div class="page-intro">
                  <div>
                    <h1 class="page-title"><%= yield :title %></h1>
                  </div>
                  <% if content_for?(:actions) %>
                    <div class="page-intro-actions btn-list"><%= yield :actions %></div>
                  <% end %>
                </div>
              <% end %>
              <%= yield %>
            <% end %>
          </div>
        </main>
      </div>
    </div>
    <%= render "admin/shared/command_palette" %>
    <%= render "admin/shared/rejection_dialog" %>
    <%= render "layouts/toasts" %>
  </body>
</html>
