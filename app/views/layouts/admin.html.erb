<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('app.name')}" : t("app.name") %></title>
    <%= render "layouts/head" %>
  </head>
  <body class="app-ui admin-layout">
    <a href="#main-content" class="skip-link"><%= t("ui.skip_to_content") %></a>
    <div class="page">
      <aside class="navbar navbar-vertical navbar-expand-lg app-sidebar" aria-label="<%= t("ui.main_navigation") %>">
        <div class="container-fluid">
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu"
                  aria-controls="sidebar-menu" aria-expanded="false" aria-label="<%= t('navigation.toggle') %>">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="navbar-brand">
            <%= link_to admin_root_path, class: "app-brand text-reset text-decoration-none" do %>
              <span class="brand-mark"><%= icon("receipt-2") %></span><span><%= t("app.name") %></span>
            <% end %>
          </div>
          <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav">
              <%= nav_section t("navigation.sections.overview") %>
              <%= nav_link t("navigation.dashboard"), admin_root_path, "layout-dashboard", resource: :dashboard, active: current_page?(admin_root_path) %>
              <%= nav_link t("navigation.transactions"), admin_transactions_path, "arrows-exchange", resource: :transactions %>
              <%= nav_link t("navigation.reviews"), admin_reviews_path, "scan", resource: :reviews %>
              <%= nav_link t("navigation.bill_uploads"), new_admin_bill_upload_path, "upload", resource: :bill_uploads %>

              <% if can?(:read, :dealers) || can?(:read, :merchants) || can?(:read, :fee_rules) %>
                <%= nav_section t("navigation.sections.configuration") %>
              <% end %>
              <%= nav_link t("navigation.dealers"), admin_dealers_path, "users", resource: :dealers %>
              <%= nav_link t("navigation.telegram_chats"), admin_telegram_chats_path, "brand-telegram", resource: :telegram_chats %>
              <%= nav_link t("navigation.merchants"), admin_merchants_path, "building-store", resource: :merchants %>
              <%= nav_link t("navigation.fee_rules"), admin_fee_rules_path, "percentage", resource: :fee_rules %>

              <% if can?(:read, :excel_exports) || can?(:read, :audit_logs) %>
                <%= nav_section t("navigation.sections.operations") %>
              <% end %>
              <%= nav_link t("navigation.excel_exports"), admin_excel_exports_path, "file-spreadsheet", resource: :excel_exports %>
              <%= nav_link t("navigation.audit_logs"), admin_audit_logs_path, "history", resource: :audit_logs %>

              <% if can?(:read, :users) || can?(:read, :settings) %>
                <%= nav_section t("navigation.sections.system") %>
              <% end %>
              <%= nav_link t("navigation.users"), admin_users_path, "user-cog", resource: :users %>
              <%= nav_link t("navigation.card_types"), admin_card_types_path, "credit-card", resource: :card_types %>
              <%= nav_link t("navigation.settings"), admin_settings_path, "settings", resource: :settings %>
            </ul>
            <div class="sidebar-footer d-none d-lg-block"><%= t("app.tagline") %></div>
          </div>
        </div>
      </aside>

      <div class="page-wrapper">
        <header class="navbar navbar-expand-md app-topbar d-print-none">
          <div class="container-xl">
            <div class="navbar-nav flex-row order-md-last ms-auto align-items-center gap-3">
              <%= render "layouts/theme_switcher" %>
              <div class="nav-item dropdown">
                <button type="button" class="btn account-trigger d-flex lh-1 text-reset" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('navigation.account') %>">
                  <span class="avatar avatar-sm account-avatar"><%= current_user.display_name.first.upcase %></span>
                  <span class="d-none d-xl-block ps-2 text-start">
                    <span class="d-block"><%= current_user.display_name %></span>
                    <span class="d-block mt-1 small text-secondary"><%= enum_label(:user, :role, current_user.role) %></span>
                  </span>
                </button>
                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                  <span class="dropdown-header"><%= current_user.email %></span>
                  <%= button_to destroy_user_session_path, method: :delete, class: "dropdown-item", form: { data: { turbo: false } } do %>
                    <%= icon("logout", "dropdown-item-icon") %> <%= t("navigation.logout") %>
                  <% end %>
                </div>
              </div>
            </div>
            <div class="navbar-nav d-none d-md-flex">
              <span class="text-secondary small"><%= icon("clock") %> <%= l(Time.current, format: :short) %> (<%= t("app.timezone_label") %>)</span>
            </div>
          </div>
        </header>

        <div class="page-header d-print-none">
          <div class="container-xl">
            <div class="row g-2 align-items-center">
              <div class="col">
                <% if content_for?(:breadcrumbs) %>
                  <ol class="breadcrumb breadcrumb-arrows mb-2" aria-label="<%= t("ui.breadcrumbs") %>"><%= yield :breadcrumbs %></ol>
                <% end %>
                <h1 class="page-title"><%= yield :title %></h1>
              </div>
              <% if content_for?(:actions) %>
                <div class="col-auto ms-auto d-print-none">
                  <div class="btn-list"><%= yield :actions %></div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <main class="page-body" id="main-content" tabindex="-1">
          <div class="container-xl">
            <%= render "layouts/flash" %>
            <%= yield %>
          </div>
        </main>

        <footer class="footer footer-transparent d-print-none">
          <div class="container-xl text-secondary small">
            <%= t("app.name") %> · <%= t("app.footer") %>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
