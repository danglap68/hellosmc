<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
  <head>
    <title><%= t("runner_codes.title") %> · <%= t("app.name") %></title>
    <meta name="turbo-cache-control" content="no-cache">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#e6ecf3">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "tabler.min", "tabler-icons.min", "application", "codes", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "tabler.min", defer: true, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="codes-board">
    <a href="#main-content" class="skip-link"><%= t("ui.skip_to_content") %></a>
    <%= yield %>
  </body>
</html>
