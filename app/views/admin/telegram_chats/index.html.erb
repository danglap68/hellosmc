<% content_for :title, t("telegram_chats.index.title") %>
<% content_for :actions do %>
  <% if can?(:manage, :telegram_chats) %>
    <%= link_to new_admin_telegram_chat_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("telegram_chats.index.new") %><% end %>
  <% end %>
<% end %>

<div class="alert alert-info"><%= icon("info-circle") %> <%= t("telegram_chats.index.help") %></div>

<%= list_toolbar(
      url: admin_settings_organization_telegram_chats_path,
      search: { param: "q", value: params[:q], placeholder: t("telegram_chats.index.title") },
      default_sort: "name_asc",
      sorts: [
        { key: "name_asc", label: t("toolbar.sorts.name_asc") },
        { key: "name_desc", label: t("toolbar.sorts.name_desc") },
        { key: "newest", label: t("toolbar.sorts.newest") }
      ],
      filters: [
        { type: :single, name: "filter", label: t("toolbar.active_state"), value: params[:filter], options: [[t("common.active"), "active"], [t("common.inactive"), "inactive"]] }
      ]
    ) %>

<div class="card">
  <% if @telegram_chats.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead>
          <tr>
            <th><%= TelegramChat.human_attribute_name(:name) %></th>
            <th><%= TelegramChat.human_attribute_name(:telegram_chat_id) %></th>
            <th><%= t("telegram_chats.messages") %></th>
            <th><%= TelegramChat.human_attribute_name(:active) %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% @telegram_chats.each do |chat| %>
            <tr>
              <td><%= link_to chat.display_name, admin_telegram_chat_path(chat) %><div class="small text-secondary"><%= chat.chat_type %></div></td>
              <td><code><%= chat.telegram_chat_id %></code></td>
              <td><%= @message_counts[chat.id].to_i %></td>
              <td><%= active_badge(chat.active?) %></td>
              <%= render "admin/shared/row_actions", resource: :telegram_chats, edit_path: edit_admin_telegram_chat_path(chat),
                         delete_path: admin_telegram_chat_path(chat) %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("telegram_chats.index.empty"), t("telegram_chats.index.empty_hint"), icon_name: "brand-telegram" %></div>
  <% end %>
</div>
