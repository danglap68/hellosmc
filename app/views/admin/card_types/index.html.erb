<% content_for :title, t("card_types.index.title") %>
<% content_for :actions do %>
  <% if can?(:manage, :card_types) %>
    <%= link_to new_admin_card_type_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("card_types.index.new") %><% end %>
  <% end %>
<% end %>
<div class="alert alert-info"><%= icon("info-circle") %> <%= t("card_types.index.help") %></div>
<%= list_toolbar(
      url: admin_settings_fees_card_types_path,
      search: { param: "q", value: params[:q], placeholder: t("card_types.index.title") },
      default_sort: "position",
      sorts: [
        { key: "position", label: t("toolbar.sorts.position") },
        { key: "name_asc", label: t("toolbar.sorts.name_asc") }
      ],
      filters: [
        { type: :single, name: "active", label: t("toolbar.active_state"), value: params[:active], options: [[t("common.active"), "1"], [t("common.inactive"), "0"]] }
      ]
    ) %>
<div class="card">
  <% if @card_types.any? %>
  <div class="table-responsive">
    <table class="table table-vcenter card-table" <%= bulk_table_attributes(:card_types) %>>
      <thead>
        <tr>
          <th><%= CardType.human_attribute_name(:key) %></th>
          <th><%= CardType.human_attribute_name(:name) %></th>
          <th><%= CardType.human_attribute_name(:aliases) %></th>
          <th><%= CardType.human_attribute_name(:position) %></th>
          <th><%= CardType.human_attribute_name(:active) %></th>
          <th class="w-1"></th>
        </tr>
      </thead>
      <tbody>
        <% @card_types.each do |card_type| %>
          <tr <%= bulk_row_attributes(card_type) %>>
            <td><code><%= card_type.key %></code><% if card_type.key == CardType::DEFAULT_KEY %> <span class="badge bg-azure-lt"><%= t("card_types.default") %></span><% end %></td>
            <td><%= card_type.name %></td>
            <td><%= card_type.match_tokens.map { |token| content_tag(:code, token) }.join(" ").html_safe %></td>
            <td><%= card_type.position %></td>
            <td><%= active_badge(card_type.active?) %></td>
            <%= render "admin/shared/row_actions", resource: :card_types, edit_path: edit_admin_card_type_path(card_type),
                       delete_path: admin_card_type_path(card_type) %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% else %>
    <div class="card-body"><%= empty_state t("common.no_data") %></div>
  <% end %>
</div>
