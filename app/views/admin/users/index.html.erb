<% content_for :title, t("users.index.title") %>
<% if can?(:manage, :users) %>
  <% content_for :actions do %>
    <%= link_to new_admin_user_path, class: "btn btn-primary" do %><%= icon("user-plus") %> <%= t("users.index.new") %><% end %>
  <% end %>
<% end %>

<%= list_toolbar(
      url: admin_settings_system_users_path,
      search: { param: "q", value: params[:q], placeholder: t("users.index.title") },
      default_sort: "email",
      sorts: [
        { key: "email", label: t("toolbar.sorts.email") },
        { key: "name_asc", label: t("toolbar.sorts.name_asc") },
        { key: "newest", label: t("toolbar.sorts.newest") }
      ],
      filters: [
        { type: :single, name: "role", label: User.human_attribute_name(:role), value: params[:role], options: Role.choices },
        { type: :single, name: "active", label: t("toolbar.active_state"), value: params[:active], options: [[t("common.active"), "1"], [t("common.inactive"), "0"]] }
      ]
    ) %>

<div class="card">
  <% if @users.any? %>
  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          <th><%= User.human_attribute_name(:email) %></th>
          <th><%= User.human_attribute_name(:name) %></th>
          <th><%= User.human_attribute_name(:role) %></th>
          <th><%= User.human_attribute_name(:active) %></th>
          <th><%= User.human_attribute_name(:last_sign_in_at) %></th>
          <th class="w-1"></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.email %><% if user == current_user %> <span class="badge bg-azure-lt"><%= t("users.you") %></span><% end %></td>
            <td><%= user.name || "—" %></td>
            <td><%= user.role_name %></td>
            <td>
              <%= active_badge(user.active?) %>
              <% if user.access_locked? %><span class="badge bg-red-lt"><%= t("users.locked") %></span><% end %>
            </td>
            <td><%= format_datetime(user.last_sign_in_at) %></td>
            <%= render "admin/shared/row_actions", resource: :users, edit_path: edit_admin_user_path(user),
                       delete_path: (admin_user_path(user) unless user == current_user), confirm: t("users.confirm_delete"),
                       extra: button_to(send_reset_password_admin_user_path(user), class: "dropdown-item",
                                        form: { data: { turbo_confirm: t("users.confirm_reset", email: user.email) } }) {
                                safe_join([icon("key", "dropdown-item-icon"), " ", t("users.send_reset")])
                              } %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("common.no_data") %></div>
  <% end %>
</div>
