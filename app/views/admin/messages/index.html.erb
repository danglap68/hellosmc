<% content_for :title, t("messages.index.title") %>
<% content_for :bare_page, "1" %>

<header class="chat-page-head">
  <div>
    <h1><%= t("messages.index.title") %></h1>
    <p><%= t("messages.index.description") %></p>
  </div>
  <%= link_to admin_messages_path(chat_navigation(chat_id: params[:chat_id].presence, q: @query.presence)), class: "btn btn-sm chat-refresh" do %>
    <%= icon("refresh") %> <%= t("messages.index.refresh") %>
  <% end %>
</header>

<div class="chat-app <%= "chat-app-thread" if params[:chat_id].present? && @chat %>" data-controller="chat-workspace" data-chat-workspace-info-open-value="<%= !@missing_ids.nil? %>" data-action="keydown.esc@window->chat-workspace#closeInfo">
  <aside class="chat-inbox" aria-label="<%= t("messages.index.groups") %>">
    <div class="chat-inbox-head">
      <div class="chat-inbox-title"><h2><%= t("messages.index.inbox") %></h2><span><%= @health.rows.size %></span></div>
      <span class="chat-channel"><%= icon("brand-telegram") %> <%= t("messages.sources.telegram") %></span>
    </div>
    <%= form_with url: admin_messages_path, method: :get, class: "chat-search chat-group-search", role: "search" do |form| %>
      <%= hidden_field_tag :filter, @filter unless @filter == "all" %>
      <%= icon("search") %>
      <%= form.search_field :group_q, value: @group_query, placeholder: t("messages.index.search_groups"), aria: { label: t("messages.index.search_groups") }, autocomplete: "off" %>
      <button type="submit" aria-label="<%= t("messages.index.search") %>"><%= icon("arrow-right") %></button>
    <% end %>
    <nav class="chat-filters" aria-label="<%= t("messages.index.filter_groups") %>">
      <% %w[all active inactive].each do |filter| %>
        <%= link_to t("messages.index.filters.#{filter}"), admin_messages_path(chat_navigation(filter: filter == "all" ? nil : filter)), aria: { current: ("page" if @filter == filter) } %>
      <% end %>
    </nav>
    <div class="chat-conv-list">
      <% if @conversations.any? %>
        <% @conversations.each do |row| %>
          <% preview = @previews[row.chat.id] %>
          <%= link_to admin_messages_path(chat_navigation(chat_id: row.chat.id)), class: "chat-conv", aria: { current: ("page" if @chat&.id == row.chat.id) } do %>
            <span class="chat-group-avatar" aria-hidden="true"><%= icon("users") %></span>
            <span class="chat-conv-content">
              <span class="chat-conv-heading">
                <span class="chat-conv-name" title="<%= row.chat.display_name %>"><%= row.chat.display_name %></span>
                <time class="chat-conv-time" datetime="<%= preview&.sent_at&.iso8601 %>"><%= chat_list_time(preview&.sent_at) %></time>
              </span>
              <span class="chat-conv-preview"><%= chat_preview(preview) %></span>
              <% unless row.chat.active? %><span class="chat-conv-paused"><%= t("messages.index.bill_paused") %></span><% end %>
            </span>
          <% end %>
        <% end %>
      <% else %>
        <div class="chat-empty">
          <%= icon("search") %>
          <h3><%= t(@group_query.present? || @filter != "all" ? "messages.index.no_matching_groups" : "messages.index.no_groups") %></h3>
          <% if @group_query.present? || @filter != "all" %><%= link_to t("messages.index.reset_filters"), admin_messages_path %><% end %>
        </div>
      <% end %>
    </div>
    <div class="chat-inbox-foot"><%= icon("brand-telegram") %> <%= t("messages.index.channel_count", count: @health.rows.size) %></div>
  </aside>

  <section class="chat-stage" data-controller="chat-preview" aria-label="<%= @chat ? @chat.display_name : t("messages.index.title") %>">
    <% if @chat %>
      <header class="chat-stage-head">
        <%= link_to admin_messages_path(chat_navigation), class: "chat-back chat-icon-button", aria: { label: t("messages.index.back") } do %><%= icon("arrow-left") %><% end %>
        <span class="chat-group-avatar" aria-hidden="true"><%= icon("users") %></span>
        <div class="chat-stage-heading">
          <h2><%= @chat.display_name %></h2>
          <p><span class="chat-platform"><%= icon("brand-telegram") %> <%= t("messages.sources.telegram") %></span><span><%= t("messages.index.today_count", count: @chat_health&.today_count.to_i) %></span></p>
        </div>
        <button type="button" class="chat-icon-button chat-info-toggle" data-chat-workspace-target="infoToggle" data-action="chat-workspace#toggleInfo" aria-expanded="false" aria-controls="chat-info" aria-label="<%= t("messages.index.info") %>"><%= icon("info-circle") %></button>
      </header>
      <%= form_with url: admin_messages_path, method: :get, class: "chat-search chat-thread-search", role: "search" do |form| %>
        <%= hidden_field_tag :chat_id, @chat.id %>
        <% chat_navigation.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
        <%= icon("search") %>
        <%= form.search_field :q, value: @query, placeholder: t("messages.index.search_thread"), aria: { label: t("messages.index.search_thread") }, autocomplete: "off" %>
        <% if @query.present? %><%= link_to admin_messages_path(chat_navigation(chat_id: @chat.id)), class: "chat-search-clear", aria: { label: t("messages.index.clear_search") } do %><%= icon("x") %><% end %><% end %>
        <button type="submit" aria-label="<%= t("messages.index.search") %>"><%= icon("arrow-right") %></button>
      <% end %>
      <% if @query.present? || @older_window %>
        <div class="chat-window-note" role="status">
          <span><%= @query.present? ? t("messages.index.search_count", count: @search_count) : t("messages.index.older_window") %></span>
          <%= link_to t("messages.index.latest"), admin_messages_path(chat_navigation(chat_id: @chat.id)) %>
        </div>
      <% end %>
      <div class="chat-thread" data-controller="chat-thread" data-chat-thread-history-value="<%= @older_window || @query.present? %>">
        <ol class="chat-log" data-chat-thread-target="log" data-action="scroll->chat-thread#scrolled" aria-label="<%= t("messages.index.history") %>">
          <% if @has_older && @messages.any? %>
            <li class="chat-older"><%= link_to t("messages.index.older"), admin_messages_path(chat_navigation(chat_id: @chat.id, before_id: @messages.first.id, q: @query.presence)), class: "btn btn-sm" %></li>
          <% end %>
          <% tones = chat_tone_map(@messages.map { |message| chat_sender_key(message) }) %>
          <% @messages.each_with_index do |message, index| %>
            <% if index.zero? || message.sent_at&.to_date != @messages[index - 1].sent_at&.to_date %>
              <li class="chat-date"><span><%= chat_date(message.sent_at) %></span></li>
            <% end %>
            <%= render "bubble", message: message, tones: tones %>
          <% end %>
          <% if @messages.empty? %>
            <li class="chat-empty">
              <%= icon(@query.present? ? "search" : "messages") %>
              <h3><%= t(@query.present? ? "messages.index.no_results" : "messages.index.thread_empty") %></h3>
              <p><%= t(@query.present? ? "messages.index.try_search" : "messages.index.thread_empty_hint") %></p>
            </li>
          <% end %>
        </ol>
        <button type="button" class="chat-jump" data-chat-thread-target="latest" data-action="chat-thread#jump" hidden><%= icon("arrow-down") %> <%= t("messages.index.latest") %></button>
      </div>
      <footer class="chat-stage-foot"><%= icon("history") %> <%= t("messages.index.history_hint") %></footer>
      <dialog class="chat-preview" data-chat-preview-target="dialog" data-action="click->chat-preview#backdrop close->chat-preview#closed" aria-label="<%= t("messages.index.preview") %>">
        <button type="button" class="chat-preview-close" data-action="chat-preview#close" aria-label="<%= t("actions.close") %>"><%= icon("x") %></button>
        <img data-chat-preview-target="image" alt="">
      </dialog>
    <% else %>
      <div class="chat-empty chat-stage-empty"><%= icon("messages") %><h2><%= t("messages.index.inbox") %></h2><p><%= t("messages.index.pick") %></p></div>
    <% end %>
  </section>
  <% if @chat %><%= render "info" %><% end %>
</div>
