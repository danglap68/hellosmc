<% content_for :title, t("remitter_transfers.index.title") %>

<%= list_toolbar(
      url: admin_remitter_transfers_path,
      search: { param: "q", value: params[:q], placeholder: t("remitter_transfers.index.title") },
      default_sort: "newest",
      sorts: [
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "oldest", label: t("toolbar.sorts.oldest") },
        { key: "amount_desc", label: t("toolbar.sorts.amount_desc") },
        { key: "amount_asc", label: t("toolbar.sorts.amount_asc") }
      ],
      filters: [
        { type: :single, name: "queue", label: t("toolbar.queue"), include_blank: false, chip: params[:queue].present?, value: @queue,
          options: Admin::RemitterTransfersController::QUEUES.keys.map { |queue| ["#{t("remitter_transfers.queues.#{queue}")} (#{@counts[queue].to_i})", queue] } },
        { type: :single, name: "dealer_id", label: RemitterTransfer.human_attribute_name(:dealer), value: params[:dealer_id], options: dealer_options },
        { type: :date_range, key: "dates", label: RemitterTransfer.human_attribute_name(:slip_at), from_name: "date_from", to_name: "date_to", from_value: params[:date_from], to_value: params[:date_to] }
      ]
    ) %>

<div class="card">
  <% if @transfers.any? %>
    <div class="table-responsive transfer-table-scroll" tabindex="0" role="region" aria-label="<%= t("remitter_transfers.index.title") %>">
      <table class="table table-vcenter card-table remitter-transfers-table">
        <colgroup>
          <col class="transfer-reference-column">
          <col class="transfer-time-column">
          <col>
          <col class="transfer-sender-column">
          <col class="transfer-amount-column">
          <col class="transfer-state-column">
          <col class="transfer-actions-column">
        </colgroup>
        <thead>
          <tr>
            <th scope="col">ID / <%= t("remitter_transfers.index.code") %></th>
            <th scope="col"><%= RemitterTransfer.human_attribute_name(:slip_at) %></th>
            <th scope="col"><%= t("transactions.show.hkd") %> / <%= RemitterTransfer.human_attribute_name(:dealer) %></th>
            <th scope="col"><%= RemitterTransfer.human_attribute_name(:remitter) %></th>
            <th scope="col" class="text-end"><%= RemitterTransfer.human_attribute_name(:amount_vnd) %></th>
            <th scope="col"><%= RemitterTransfer.human_attribute_name(:status) %></th>
            <th scope="col"><span class="visually-hidden"><%= t("actions.view") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @transfers.each do |transfer| %>
            <tr>
              <td class="transfer-reference">
                <%= link_to "##{transfer.id}", admin_remitter_transfer_path(transfer) %>
                <div class="transfer-secondary" title="<%= RemitterTransfer.human_attribute_name(:transfer_code) %>"><%= transfer.transfer_code.presence || "—" %></div>
              </td>
              <td>
                <% if (slip_at = transfer.slip_at) %>
                  <time class="transfer-time" datetime="<%= slip_at.iso8601 %>">
                    <span><%= l(slip_at.to_date) %></span>
                    <% unless slip_at.is_a?(Date) %><span class="transfer-secondary"><%= l(slip_at, format: "%H:%M:%S") %></span><% end %>
                  </time>
                <% else %>
                  <span class="text-secondary">—</span>
                <% end %>
              </td>
              <td class="transfer-party">
                <div class="transfer-merchant"><%= transfer.merchant_dealer&.merchant&.name || "—" %></div>
                <div class="transfer-secondary"><%= transfer.dealer&.name || "—" %></div>
              </td>
              <td class="transfer-sender"><%= transfer.remitter&.name || content_tag(:span, t("remitter_transfers.unknown_remitter"), class: "text-orange") %></td>
              <td class="text-end money transfer-amount"><%= format_vnd(transfer.amount_vnd) %></td>
              <td class="transfer-state">
                <%= remitter_transfer_status_badge(transfer) %>
                <% reasons = transfer.active_review_reasons %>
                <% if reasons.any? %>
                  <p class="transfer-review-reason"><%= remitter_transfer_reason(reasons.first) %></p>
                  <% if reasons.many? %>
                    <details class="transfer-more-reasons">
                      <summary><%= t("remitter_transfers.index.more_reasons", count: reasons.size - 1) %></summary>
                      <ul><% reasons.drop(1).each do |reason| %><li><%= remitter_transfer_reason(reason) %></li><% end %></ul>
                    </details>
                  <% end %>
                <% end %>
                <% if transfer.rd_cell %><div class="transfer-secondary transfer-sheet"><%= t("remitter_transfers.index.sheet_location") %>: <span><%= transfer.rd_sheet %>!<%= transfer.rd_cell %></span></div><% end %>
              </td>
              <td class="text-nowrap text-end transfer-actions">
                <div class="row-actions">
                  <%= link_to admin_remitter_transfer_path(transfer), class: "btn btn-sm btn-ghost-secondary btn-icon", title: t("actions.view"), aria: { label: t("actions.view") } do %><%= icon("eye") %><% end %>
                  <%= render "retry_button", transfer: transfer, icon_only: true %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("remitter_transfers.index.empty") %></div>
  <% end %>
</div>
