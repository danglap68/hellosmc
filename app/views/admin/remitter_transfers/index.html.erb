<% content_for :title, t("remitter_transfers.index.title") %>

<%= list_toolbar(
      url: admin_remitter_transfers_path,
      search: { param: "q", value: params[:q], placeholder: t("remitter_transfers.index.title") },
      default_sort: "newest",
      sorts: [
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "oldest", label: t("toolbar.sorts.oldest") },
        { key: "amount_desc", label: t("toolbar.sorts.amount_desc") },
        { key: "amount_asc", label: t("toolbar.sorts.amount_asc") }
      ],
      filters: [
        { type: :single, name: "queue", label: t("toolbar.queue"), include_blank: false, chip: params[:queue].present?, value: @queue,
          options: Admin::RemitterTransfersController::QUEUES.keys.map { |queue| ["#{t("remitter_transfers.queues.#{queue}")} (#{@counts[queue].to_i})", queue] } },
        { type: :single, name: "dealer_id", label: RemitterTransfer.human_attribute_name(:dealer), value: params[:dealer_id], options: dealer_options },
        { type: :date_range, key: "dates", label: RemitterTransfer.human_attribute_name(:slip_at), from_name: "date_from", to_name: "date_to", from_value: params[:date_from], to_value: params[:date_to] }
      ]
    ) %>

<div class="card">
  <% if @transfers.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= RemitterTransfer.human_attribute_name(:slip_at) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:remitter) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:transfer_code) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:merchant) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:dealer) %></th>
            <th class="text-end"><%= RemitterTransfer.human_attribute_name(:amount_vnd) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:status) %></th>
            <th><%= RemitterTransfer.human_attribute_name(:rd_cell) %></th>
            <th class="w-1 transfer-actions"></th>
          </tr>
        </thead>
        <tbody>
          <% @transfers.each do |transfer| %>
            <tr>
              <td><%= link_to "##{transfer.id}", admin_remitter_transfer_path(transfer) %></td>
              <td class="text-nowrap"><%= remitter_slip_datetime(transfer) %></td>
              <td><%= transfer.remitter&.name || content_tag(:span, t("remitter_transfers.unknown_remitter"), class: "text-orange") %></td>
              <td><%= transfer.transfer_code ? content_tag(:code, transfer.transfer_code) : "—" %></td>
              <td><%= transfer.merchant_dealer&.merchant&.name || "—" %></td>
              <td><%= transfer.dealer&.name || "—" %></td>
              <td class="text-end money"><%= format_vnd(transfer.amount_vnd) %></td>
              <td>
                <%= remitter_transfer_status_badge(transfer) %>
                <% transfer.review_reasons.each do |reason| %>
                  <span class="badge bg-yellow-lt"><%= remitter_transfer_reason(reason) %></span>
                <% end %>
              </td>
              <td><%= transfer.rd_cell ? "#{transfer.rd_sheet}!#{transfer.rd_cell}" : "—" %></td>
              <td class="text-nowrap text-end transfer-actions">
                <div class="row-actions">
                  <%= link_to admin_remitter_transfer_path(transfer), class: "btn btn-sm btn-ghost-secondary btn-icon", title: t("actions.view"), aria: { label: t("actions.view") } do %><%= icon("eye") %><% end %>
                  <%= render "retry_button", transfer: transfer, icon_only: true %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("remitter_transfers.index.empty") %></div>
  <% end %>
</div>
