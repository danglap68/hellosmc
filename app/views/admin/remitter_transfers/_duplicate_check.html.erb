<div class="alert alert-warning d-block text-body" data-testid="transfer-duplicates">
  <h4 class="alert-title"><%= t("remitter_transfers.duplicates.title") %></h4>
  <% if transfer.written? && duplicate_check.matches.any? { |match| match.transfer.written? } %>
    <p class="fw-semibold mb-2"><%= t("remitter_transfers.duplicates.both_written") %></p>
    <p class="small mb-2"><%= t("remitter_transfers.duplicates.current_written", id: transfer.id, cell: "#{transfer.rd_sheet}!#{transfer.rd_cell}") %></p>
  <% end %>
  <% if duplicate_check.matches.any? %>
    <ul class="list-unstyled mb-0">
      <% duplicate_check.matches.each_with_index do |match, index| %>
        <% other = match.transfer %>
        <li class="<%= "mt-3" if index.positive? %>">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <%= link_to t("remitter_transfers.duplicates.transfer", id: other.id), admin_remitter_transfer_path(other), class: "fw-bold text-decoration-underline" %>
            <%= remitter_transfer_status_badge(other) %>
          </div>
          <% match.reasons.each do |reason| %>
            <div><%= t("remitter_transfers.duplicates.reasons.#{reason}", minutes: duplicate_check.window_minutes) %></div>
          <% end %>
          <div class="small mt-1">
            <%= other.remitter&.name || t("remitter_transfers.unknown_remitter") %> ·
            <%= other.transfer_code || "—" %> · <span class="money"><%= format_vnd(other.amount_vnd) %></span>
          </div>
          <div class="small"><%= t("remitter_transfers.duplicates.sent_at", time: format_datetime(other.transferred_at)) %></div>
          <% if other.written? %>
            <div class="small fw-semibold"><%= t("remitter_transfers.duplicates.written", cell: "#{other.rd_sheet}!#{other.rd_cell}") %></div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif duplicate_check.original_image %>
    <p class="mb-1"><%= t("remitter_transfers.duplicates.original_image", id: duplicate_check.original_image.id) %></p>
    <% if can?(:read, :bill_images) %>
      <%= link_to t("remitter_transfers.duplicates.open_image"), admin_bill_image_path(duplicate_check.original_image), class: "text-decoration-underline" %>
    <% end %>
  <% else %>
    <p class="mb-0"><%= t("remitter_transfers.duplicates.unavailable") %></p>
  <% end %>
</div>
