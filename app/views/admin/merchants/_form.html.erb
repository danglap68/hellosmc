<%= tabler_form_with model: [:admin, merchant] do |form| %>
  <div class="card">
    <div class="card-body">
      <%= form.error_summary %>
      <%= form.field :name, required: true, hint: t("merchants.form.name_hint") %>
      <div class="row">
        <div class="col-md-4"><%= form.field :code, required: true %></div>
      </div>
      <%= form.select_field :default_card_type_id, card_type_options, { include_blank: t("merchants.form.no_default_card_type") },
            hint: t("merchants.form.default_card_type_hint") %>
      <%= form.switch_field :active %>
    </div>
    <% if merchant.persisted? %>
      <div class="card-body border-top">
        <h3 class="card-title mb-3"><%= icon("users") %> <%= t("merchants.form.agents") %></h3>
        <%= form.fields_for :merchant_dealers do |md| %>
          <div class="row align-items-end mb-1">
            <div class="col-md-5"><%= md.select_field :dealer_id, dealer_options, { include_blank: t("reviews.choose") } %></div>
            <div class="col-md-4"><%= md.field :tid_key, hint: t("merchants.form.tid_key_hint") %></div>
            <div class="col-md-3">
              <% if md.object.persisted? %>
                <label class="form-check mb-3">
                  <%= md.check_box :_destroy, class: "form-check-input" %>
                  <span class="form-check-label"><%= t("actions.delete") %></span>
                </label>
              <% end %>
            </div>
          </div>
          <div class="row">
            <div class="col-md-5"><%= md.field :transfer_code, hint: t("merchants.form.transfer_code_hint") %></div>
          </div>
          <details class="mb-3" <%= "open" if md.object.errors.any? %>>
            <summary class="small text-secondary"><%= t("merchants.form.sheet_names") %></summary>
            <div class="row mt-2">
              <div class="col-md-4"><%= md.field :ds_sheet_anchor, hint: t("merchants.form.ds_sheet_anchor_hint") %></div>
              <div class="col-md-4"><%= md.field :ds_header, hint: t("merchants.form.ds_header_hint") %></div>
              <div class="col-md-4"><%= md.field :rd_agent_label, hint: t("merchants.form.rd_agent_label_hint") %></div>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>
    <div class="card-footer d-flex gap-2">
      <%= form.submit_button %>
      <%= link_to t("actions.cancel"), merchant.persisted? ? admin_merchant_path(merchant) : admin_merchants_path, class: "btn btn-link" %>
    </div>
  </div>
<% end %>
