<% content_for :title, t("merchants.index.title") %>
<% content_for :actions do %>
  <% if can?(:manage, :merchants) %>
    <%= link_to new_admin_merchant_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("merchants.index.new") %><% end %>
  <% end %>
<% end %>

<%= list_toolbar(
      url: admin_settings_organization_merchants_path,
      search: { param: "q", value: params[:q], placeholder: t("merchants.index.title") },
      default_sort: "name_asc",
      sorts: [
        { key: "name_asc", label: t("toolbar.sorts.name_asc") },
        { key: "name_desc", label: t("toolbar.sorts.name_desc") },
        { key: "code", label: t("toolbar.sorts.code") },
        { key: "newest", label: t("toolbar.sorts.newest") }
      ],
      filters: [
        { type: :single, name: "active", label: t("toolbar.active_state"), value: params[:active], options: [[t("common.active"), "1"], [t("common.inactive"), "0"]] },
        { type: :boolean, name: "skip_bills", label: Merchant.human_attribute_name(:skip_bills), option_label: Merchant.human_attribute_name(:skip_bills), checked_value: "1", value: params[:skip_bills] }
      ]
    ) %>

<div class="card">
  <% if @merchants.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table" <%= bulk_table_attributes(:merchants) %>>
        <thead>
          <tr>
            <th><%= Merchant.human_attribute_name(:name) %></th>
            <th><%= Merchant.human_attribute_name(:code) %></th>
            <th><%= Merchant.human_attribute_name(:default_card_type) %></th>
            <th><%= t("merchants.aliases") %></th>
            <th><%= Merchant.human_attribute_name(:active) %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% @merchants.each do |merchant| %>
            <tr <%= bulk_row_attributes(merchant) %>>
              <td><%= link_to merchant.name, admin_merchant_path(merchant) %></td>
              <td><code><%= merchant.code %></code></td>
              <td><%= merchant.default_card_type&.name || "—" %></td>
              <td><%= @alias_counts[merchant.id].to_i %></td>
              <td><%= active_badge(merchant.active?) %></td>
              <%= render "admin/shared/row_actions", resource: :merchants, edit_path: edit_admin_merchant_path(merchant),
                         delete_path: admin_merchant_path(merchant) %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("merchants.index.empty") %></div>
  <% end %>
</div>
