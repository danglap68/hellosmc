<% content_for :title, t("fee_rules.index.title") %>
<% content_for :actions do %>
  <% if can?(:manage, :fee_rules) %>
    <%= link_to new_admin_fee_rule_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("fee_rules.index.new") %><% end %>
  <% end %>
<% end %>

<div class="alert alert-info">
  <h4 class="alert-title"><%= icon("info-circle") %> <%= t("fee_rules.index.how_title") %></h4>
  <ol class="mb-1">
    <% FeeRule::SPECIFICITY_LEVELS.each do |level| %>
      <li><%= t("fee_rules.levels.#{level}") %></li>
    <% end %>
  </ol>
  <div class="small"><%= t("fee_rules.index.how_priority") %></div>
</div>

<%= list_toolbar(
      url: admin_settings_fees_rules_path,
      search: { param: "q", value: params[:q], placeholder: t("fee_rules.index.title") },
      default_sort: "priority",
      sorts: [
        { key: "priority", label: t("toolbar.sorts.priority") },
        { key: "newest", label: t("toolbar.sorts.newest") }
      ],
      filters: [
        { type: :single, name: "dealer_id", label: Transaction.human_attribute_name(:dealer), value: params[:dealer_id], options: dealer_options },
        { type: :single, name: "merchant_id", label: Transaction.human_attribute_name(:merchant), value: params[:merchant_id], options: merchant_options },
        { type: :single, name: "card_type_id", label: Transaction.human_attribute_name(:card_type), value: params[:card_type_id], options: card_type_options },
        { type: :single, name: "state", label: t("toolbar.active_state"), value: params[:state], options: [[t("fee_rules.index.state_current"), "current"], [t("common.inactive"), "inactive"]] }
      ]
    ) %>

<div class="card">
  <%= render "table", fee_rules: @fee_rules %>
  <%= pagination(@pagy) %>
</div>
