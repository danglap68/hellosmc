<% content_for :title, t("dashboard.title") %>
<% content_for :bare_page, "1" %>
<% current = @stats.current_snapshot %>
<% previous = @stats.previous_snapshot %>
<% trends = @stats.trend_buckets %>
<% chart = @stats.card_chart %>

<header class="overview-intro">
  <div>
    <h1><%= t("dashboard.title") %></h1>
    <p><%= t("dashboard.description") %></p>
  </div>
  <div class="overview-controls">
    <nav class="period-switch" aria-label="<%= t("dashboard.period_label") %>">
      <% Dashboard::Stats::PERIODS.each do |period| %>
        <%= link_to t("dashboard.periods.#{period}"), admin_root_path(period: period), class: "period-option", aria: { current: ("page" if period == @period) } %>
      <% end %>
    </nav>
    <p class="overview-range"><%= t("dashboard.period_range", from: l(@stats.period_start), to: l(@stats.period_end)) %></p>
  </div>
</header>

<section class="kpi-board" aria-label="<%= t("dashboard.title") %>">
  <% [
       [:gross, format_vnd(current[:gross]), period_delta(current[:gross], previous[:gross]), trends.map { |row| row[:gross] }, t("dashboard.kpis.gross_context"), true],
       [:count, current[:count], period_delta(current[:count], previous[:count]), trends.map { |row| row[:count] }, t("dashboard.kpis.count_context", count: current[:approved_count]), false],
       [:fee, format_vnd(current[:base_fee]), period_delta(current[:base_fee], previous[:base_fee]), trends.map { |row| row[:base_fee] }, t("dashboard.kpis.fee_context"), false],
       [:after_fee, format_vnd(current[:after_fee]), period_delta(current[:after_fee], previous[:after_fee]), trends.map { |row| row[:after_fee] }, t("dashboard.kpis.after_fee_context"), false],
       [:profit, format_vnd(current[:profit]), period_delta(current[:profit], previous[:profit]), trends.map { |row| row[:profit] }, t("dashboard.kpis.profit_context"), false],
       [:approval, share_percent(current[:approval_rate]), period_delta(current[:approval_rate], previous[:approval_rate], mode: :rate), trends.map { |row| row[:approval_rate].to_f }, current[:decided].zero? ? t("dashboard.kpis.approval_empty") : t("dashboard.kpis.approval_context", approved: current[:approved_count], decided: current[:decided]), false]
     ].each do |key, value, delta, series, context, hero| %>
    <article class="kpi-card<%= " is-hero" if hero %>">
      <h2><%= t("dashboard.kpis.#{key}") %></h2>
      <p class="kpi-value"><%= value %></p>
      <p class="kpi-meta">
        <span class="delta-pill delta-<%= delta[:direction] %>"><%= delta[:text] %></span>
        <span class="kpi-context"><%= context %></span>
      </p>
      <div class="spark"><%= sparkline(series) %></div>
    </article>
  <% end %>
</section>

<div class="overview-split">
  <section class="card overview-chart">
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t("dashboard.chart_by_card") %></h2>
        <div class="text-secondary small"><%= t("dashboard.chart_hint") %></div>
      </div>
    </div>
    <% if chart[:buckets].any? { |bucket| bucket[:total].positive? } %>
      <div class="card-body">
        <div class="chart-legend">
          <% chart[:legend].each_with_index do |series, index| %>
            <div class="chart-legend-item">
              <span class="chart-legend-name">
                <i style="background: <%= DashboardHelper::CHART_COLORS[index % DashboardHelper::CHART_COLORS.size] %>"></i>
                <%= series[:name] %>
              </span>
              <span class="chart-legend-value"><%= format_vnd(series[:total]) %></span>
            </div>
          <% end %>
        </div>
        <div class="chart-scroll"><%= stacked_amount_chart(chart) %></div>
      </div>
    <% else %>
      <div class="card-body"><%= empty_state t("dashboard.empty_window") %></div>
    <% end %>
  </section>

  <aside class="card attention-card">
    <div class="card-header">
      <h2 class="card-title"><%= t("dashboard.attention") %></h2>
    </div>
    <% queues = [] %>
    <% if can?(:read, :reviews) %>
      <% queues << [:needs_review, @stats.needs_review, admin_reviews_path, "warning"] %>
      <% queues << [:hold, @stats.hold, admin_reviews_path(queue: "hold"), "orange"] %>
      <% queues << [:failed, @stats.failed, admin_reviews_path(queue: "failed"), "danger"] %>
    <% end %>
    <% queues << [:unmatched, @stats.unmatched_albums, admin_bill_albums_path, "warning"] if !feature_hidden?(:bill_albums) && can?(:read, :bill_albums) %>
    <% queues << [:transfers, @stats.transfers_needing_review, admin_remitter_transfers_path(queue: "needs_review"), "warning"] if can?(:read, :remitter_transfers) %>
    <% if queues.any? %>
      <ul class="attention-list">
        <% queues.each do |key, count, url, tone| %>
          <li>
            <%= link_to url, class: "attention-row" do %>
              <span class="attention-title"><%= t("dashboard.queues.#{key}") %></span>
              <span class="attention-count tone-<%= tone %>"><%= count %></span>
              <%= icon("chevron-right", "attention-chevron") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card-body"><%= empty_state t("dashboard.attention_empty") %></div>
    <% end %>
  </aside>
</div>

<div class="overview-breakdowns">
  <%= render "breakdown", title: t("dashboard.by_dealer"), rows: @stats.dealer_rows, filter_key: :dealer_id %>
  <%= render "breakdown", title: t("dashboard.by_merchant"), rows: @stats.merchant_rows, filter_key: :merchant_id %>
</div>
