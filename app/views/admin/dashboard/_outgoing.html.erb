<%# locals: (stats:, current:) %>
<% outgoing = stats.outgoing_snapshot %>
<section class="card outgoing-summary mb-3" aria-labelledby="outgoing-title">
  <div class="card-header flex-wrap gap-2">
    <h2 class="card-title" id="outgoing-title"><%= t("dashboard.outgoing.title") %></h2>
    <% if can?(:read, :remitter_transfers) %>
      <%= link_to t("dashboard.outgoing.view"), admin_remitter_transfers_path(queue: "all", date_from: stats.period_start.iso8601, date_to: stats.period_end.iso8601), class: "ms-auto" %>
    <% end %>
  </div>
  <div class="card-body">
    <dl class="outgoing-metrics">
      <div data-metric="outgoing-total">
        <dt><%= t("dashboard.outgoing.total") %></dt>
        <dd class="money"><%= format_vnd(outgoing[:total]) %></dd>
        <% delta = period_delta(outgoing[:total], stats.previous_outgoing_snapshot[:total]) %>
        <dd class="outgoing-detail"><span class="delta-pill delta-<%= delta[:direction] %>"><%= delta[:text] %></span></dd>
        <dd class="outgoing-detail"><%= t("dashboard.outgoing.count", count: outgoing[:count]) %></dd>
      </div>
      <div data-metric="outgoing-approved">
        <dt><%= t("dashboard.outgoing.approved") %></dt>
        <dd class="money"><%= format_vnd(outgoing[:approved]) %></dd>
        <dd class="outgoing-detail"><%= t("dashboard.outgoing.approved_count", count: outgoing[:approved_count], written: outgoing[:written_count]) %></dd>
      </div>
      <div data-metric="outgoing-waiting">
        <dt><%= t("dashboard.outgoing.waiting") %></dt>
        <dd class="money"><%= format_vnd(outgoing[:waiting]) %></dd>
        <dd class="outgoing-detail"><%= t("dashboard.outgoing.count", count: outgoing[:waiting_count]) %></dd>
      </div>
      <div data-metric="reconciliation-difference">
        <dt><%= t("dashboard.outgoing.difference") %></dt>
        <dd class="money"><%= format_vnd(current[:dealer_payable] - outgoing[:approved]) %></dd>
        <dd class="outgoing-detail"><%= t("dashboard.outgoing.payable", amount: format_vnd(current[:dealer_payable])) %></dd>
      </div>
    </dl>
    <p class="outgoing-hint"><%= t("dashboard.outgoing.hint") %></p>
    <% if outgoing[:unread_count].positive? || current[:dealer_unread_count].positive? %>
      <p class="outgoing-hint mb-0" role="status"><%= icon("info-circle") %> <%= t("dashboard.outgoing.unread", transfers: outgoing[:unread_count], bills: current[:dealer_unread_count]) %></p>
    <% end %>
  </div>
</section>
