<% content_for :title, t("bill_albums.index.title") %>

<%= list_toolbar(
      url: admin_bill_albums_path,
      search: { param: "q", value: params[:q], placeholder: t("bill_albums.index.title") },
      default_sort: "newest",
      sorts: [
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "oldest", label: t("toolbar.sorts.oldest") },
        { key: "amount_desc", label: t("toolbar.sorts.amount_desc") },
        { key: "amount_asc", label: t("toolbar.sorts.amount_asc") }
      ],
      filters: [
        { type: :single, name: "status", label: BillAlbum.human_attribute_name(:status), value: params[:status], options: enum_options(:bill_album, :status, BillAlbum::STATUSES) },
        { type: :single, name: "reconciliation_status", label: BillAlbum.human_attribute_name(:reconciliation_status), value: params[:reconciliation_status], options: enum_options(:bill_album, :reconciliation_status, BillAlbum::RECONCILIATION_STATUSES) },
        { type: :single, name: "telegram_chat_id", label: BillAlbum.human_attribute_name(:telegram_chat), value: params[:telegram_chat_id], options: TelegramChat.ordered.map { |chat| [chat.display_name, chat.id] } },
        { type: :date_range, key: "dates", label: BillAlbum.human_attribute_name(:created_at), from_name: "date_from", to_name: "date_to", from_value: params[:date_from], to_value: params[:date_to] }
      ]
    ) %>

<div class="card">
  <% if @bill_albums.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table table-sm">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= BillAlbum.human_attribute_name(:telegram_chat) %></th>
            <th><%= BillAlbum.human_attribute_name(:created_at) %></th>
            <th><%= BillAlbum.human_attribute_name(:status) %></th>
            <th><%= BillAlbum.human_attribute_name(:reconciliation_status) %></th>
            <th class="text-end"><%= BillAlbum.human_attribute_name(:child_count) %></th>
            <th class="text-end"><%= BillAlbum.human_attribute_name(:child_total_vnd) %></th>
            <th class="text-end"><%= BillAlbum.human_attribute_name(:transfer_amount_vnd) %></th>
            <th class="text-end"><%= BillAlbum.human_attribute_name(:match_difference_vnd) %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% @bill_albums.each do |album| %>
            <tr>
              <td><%= link_to "##{album.id}", admin_bill_album_path(album) %></td>
              <td><%= album.telegram_chat&.display_name || "—" %></td>
              <td class="text-nowrap"><%= format_datetime(album.created_at) %></td>
              <td><%= album_status_badge(album) %></td>
              <td><%= reconciliation_status_badge(album) %></td>
              <td class="text-end"><%= album.child_count %></td>
              <td class="text-end money"><%= format_vnd(album.child_total_vnd) %></td>
              <td class="text-end money"><%= format_vnd(album.transfer_amount_vnd) %></td>
              <td class="text-end money"><%= format_vnd(album.match_difference_vnd) %></td>
              <td><%= link_to admin_bill_album_path(album), class: "btn btn-sm btn-ghost-secondary btn-icon", title: t("actions.view"), aria: { label: t("actions.view") } do %><%= icon("eye") %><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("bill_albums.index.empty") %></div>
  <% end %>
</div>
