<% content_for :title, t("bill_albums.show.title", id: @bill_album.id) %>
<% content_for :breadcrumbs do %>
  <li class="breadcrumb-item"><%= link_to t("navigation.bill_albums"), admin_bill_albums_path %></li>
  <li class="breadcrumb-item active">#<%= @bill_album.id %></li>
<% end %>

<div class="row row-cards">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= icon("git-compare") %> <%= t("bill_albums.show.reconciliation") %></h3></div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5"><%= BillAlbum.human_attribute_name(:telegram_chat) %></dt>
          <dd class="col-7"><%= @bill_album.telegram_chat&.display_name || "—" %></dd>
          <dt class="col-5"><%= BillAlbum.human_attribute_name(:status) %></dt>
          <dd class="col-7"><%= album_status_badge(@bill_album) %></dd>
          <dt class="col-5"><%= BillAlbum.human_attribute_name(:reconciliation_status) %></dt>
          <dd class="col-7"><%= reconciliation_status_badge(@bill_album) %></dd>
          <% unless album_children_dropped?(@bill_album) %>
            <dt class="col-5"><%= BillAlbum.human_attribute_name(:child_count) %></dt>
            <dd class="col-7"><%= @bill_album.child_count %></dd>
            <dt class="col-5"><%= BillAlbum.human_attribute_name(:child_total_vnd) %></dt>
            <dd class="col-7 money"><%= format_vnd(@bill_album.child_total_vnd) %></dd>
          <% end %>
          <dt class="col-5"><%= BillAlbum.human_attribute_name(:transfer_amount_vnd) %></dt>
          <dd class="col-7 money"><%= format_vnd(@bill_album.transfer_amount_vnd) %></dd>
          <% unless album_children_dropped?(@bill_album) %>
            <dt class="col-5"><%= BillAlbum.human_attribute_name(:match_difference_vnd) %></dt>
            <dd class="col-7 money"><%= format_vnd(@bill_album.match_difference_vnd) %></dd>
          <% end %>
        </dl>
        <% if @bill_album.skipped? %>
          <div class="alert alert-warning mt-3 mb-0"><%= icon("alert-triangle") %> <%= t("bill_albums.show.skipped_note") %></div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header"><h3 class="card-title"><%= icon("photo") %> <%= t("bill_albums.show.images") %></h3></div>
      <div class="card-body">
        <div class="row g-3">
          <% @bill_album.bill_images.each do |image| %>
            <div class="col-6 col-md-4 col-lg-3">
              <div class="card">
                <div class="card-body p-2 text-center">
                  <%= link_to admin_bill_image_path(image), target: "_blank", rel: "noopener" do %>
                    <%= image_tag admin_bill_image_path(image), class: "img-fluid rounded", alt: "" %>
                  <% end %>
                  <div class="small mt-2">
                    <% kind = album_image_kind(@bill_album, image) %>
                    <span class="badge <%= kind == 'total' ? 'bg-blue-lt' : 'bg-secondary-lt' %>"><%= album_image_label(@bill_album, image) %></span>
                    <% unless album_image_skipped?(@bill_album, image) %>
                      <%= ocr_status_badge(image.ocr_status) %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= icon("receipt") %> <%= t("bill_albums.show.transactions") %></h3></div>
      <% if @bill_album.transactions.any? %>
        <div class="table-responsive">
          <table class="table table-vcenter card-table table-sm" <%= bulk_table_attributes(:transactions) %>>
            <thead>
              <tr>
                <th>ID</th>
                <th><%= Transaction.human_attribute_name(:transaction_amount_vnd) %></th>
                <th><%= Transaction.human_attribute_name(:merchant) %></th>
                <th><%= Transaction.human_attribute_name(:status) %></th>
              </tr>
            </thead>
            <tbody>
              <% @bill_album.transactions.each do |transaction| %>
                <tr <%= bulk_row_attributes(transaction) %>>
                  <td><%= link_to "##{transaction.id}", admin_transaction_path(transaction) %></td>
                  <td class="text-end money"><%= format_vnd(transaction.transaction_amount_vnd) %></td>
                  <td><%= transaction.merchant&.name || transaction.raw_merchant_name || "—" %></td>
                  <td><%= status_badge(transaction.status) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="card-body text-secondary"><%= t("common.no_data") %></div>
      <% end %>
    </div>
  </div>
</div>
