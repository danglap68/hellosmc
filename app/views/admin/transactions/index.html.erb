<% content_for :title, t("transactions.index.title") %>

<%= list_toolbar(
      url: admin_transactions_path,
      search: { param: "q", value: @filter[:q], placeholder: t("transactions.filters.q_placeholder") },
      default_sort: "when_desc",
      sorts: [
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "oldest", label: t("toolbar.sorts.oldest") },
        { key: "when_desc", label: t("toolbar.sorts.when_desc") },
        { key: "when_asc", label: t("toolbar.sorts.when_asc") },
        { key: "amount_desc", label: t("toolbar.sorts.amount_desc") },
        { key: "amount_asc", label: t("toolbar.sorts.amount_asc") }
      ],
      filters: [
        { type: :single, name: "dealer_id", label: Transaction.human_attribute_name(:dealer), value: @filter[:dealer_id], options: dealer_options },
        { type: :single, name: "merchant_id", label: t("transactions.show.hkd"), value: @filter[:merchant_id], options: merchant_options },
        { type: :single, name: "status", label: Transaction.human_attribute_name(:status), value: @filter[:status], options: enum_options(:transaction, :status, Transaction::STATUSES) },
        { type: :single, name: "card_type_id", label: Transaction.human_attribute_name(:card_type), value: @filter[:card_type_id], options: card_type_options },
        { type: :date_range, key: "dates", label: t("toolbar.transaction_date"), from_name: "date_from", to_name: "date_to", from_value: @filter[:date_from], to_value: @filter[:date_to] },
        { type: :amount_range, key: "amounts", label: t("toolbar.amount"), min_name: "amount_min", max_name: "amount_max", min_value: @filter[:amount_min], max_value: @filter[:amount_max] },
        { type: :single, name: "telegram_chat_id", label: t("transactions.filters.telegram_chat"), value: @filter[:telegram_chat_id], options: TelegramChat.ordered.map { |chat| [chat.display_name, chat.id] } },
        { type: :single, name: "tag", label: t("transactions.filters.tag"), value: @filter[:tag], options: Transaction::SKIP_TAGS.map { |tag| [t("transactions.tags.#{tag}"), tag] } },
        { type: :boolean, name: "show_skipped", label: t("transactions.filters.tag"), option_label: t("transactions.filters.show_skipped"), checked_value: "1", value: @filter[:show_skipped] }
      ]
    ) %>

<div class="card">
  <% if @transactions.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table table-sm transactions-table">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= Transaction.human_attribute_name(:transaction_at) %></th>
            <th><%= Transaction.human_attribute_name(:merchant) %> / <%= Transaction.human_attribute_name(:dealer) %></th>
            <th class="text-end"><%= Transaction.human_attribute_name(:transaction_amount_vnd) %></th>
            <th><%= Transaction.human_attribute_name(:status) %></th>
            <th class="transaction-actions"></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td><%= link_to "##{transaction.id}", admin_transaction_path(transaction) %></td>
              <td class="text-nowrap">
                <% if transaction.transaction_at %>
                  <div><%= l(transaction.transaction_at.to_date) %></div>
                  <div class="small text-secondary"><%= transaction.transaction_at.strftime("%H:%M:%S") %></div>
                <% else %>—<% end %>
              </td>
              <td class="transaction-party">
                <% if transaction.merchant %>
                  <div><%= transaction.merchant.name %></div>
                <% else %>
                  <div class="text-secondary" title="<%= t('transactions.raw_ocr_name') %>"><%= transaction.raw_merchant_name || "—" %></div>
                <% end %>
                <div class="small text-secondary"><%= transaction.dealer&.name || "—" %></div>
                <div class="small text-secondary"><%= t("transactions.index.bill_details", card: transaction.card_type&.name || "—", lot: transaction.lot_number || "—") %></div>
              </td>
              <td class="text-end transaction-money">
                <div class="money fw-semibold"><%= format_vnd(transaction.transaction_amount_vnd) %></div>
                <div class="small text-secondary"><%= t("transactions.index.after_fee") %>: <span class="money"><%= format_vnd(transaction.amount_after_base_fee_vnd) %></span></div>
                <div class="small text-secondary"><%= t("transactions.index.base_fee") %>: <%= format_rate(transaction.base_fee_rate_used) %></div>
              </td>
              <td class="transaction-state">
                <div><%= status_badge(transaction.status) %><%= skip_tag_badges(transaction) %></div>
                <% if transaction.confidence_score %><div class="small text-secondary mt-1"><%= t("transactions.index.ocr_confidence") %>: <%= confidence_badge(transaction.confidence_score) %></div><% end %>
                <div class="mt-1"><%= image_integrity_badge(transaction) %></div>
              </td>
              <td class="transaction-actions text-end"><%= render "admin/transactions/row_actions", transaction: transaction %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("transactions.index.empty"), (@filter.active? ? t("transactions.index.empty_filtered") : nil) %></div>
  <% end %>
</div>
