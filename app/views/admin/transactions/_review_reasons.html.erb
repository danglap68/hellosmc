<%# locals: (transaction:) %>
<% codes = transaction.review_reason_codes %>
<% if codes.any? && !transaction.finalized? %>
  <div class="alert alert-warning">
    <h4 class="alert-title"><%= icon("alert-triangle") %> <%= t("transactions.review_reasons_title") %></h4>
    <ul class="mb-0">
      <% codes.each do |code| %>
        <li>
          <%= review_reason_label(code) %>
          <% if code.in?(Workbook::HelloSmcWriter::MAPPING_ISSUES) && transaction.merchant && can?(:manage, :merchants) %>
            · <%= link_to t("transactions.fix_agent_mapping"), edit_admin_merchant_path(transaction.merchant) %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if (codes & BillImages::SystemRecovery::OCR_REASONS).any? && (image = transaction.bill_image) %>
      <p class="mt-2 mb-0 small">
        <% if image.ocr_runs_remaining? && image.metadata["recovery_job_run_id"] == image.metadata.dig("vision_pipeline", "run_id") %>
          Hệ thống đã lên lịch tự đọc lại chứng từ, không cần bấm xử lý lại.
        <% elsif !image.ocr_runs_remaining? %>
          Đã dùng hết <%= image.ocr_attempts %> lượt đọc có giới hạn. Cần ảnh gốc rõ hơn để xử lý chính xác; hệ thống không tự đoán số tiền.
        <% end %>
        <% if (fields = Array(image.metadata.dig("vision_pipeline", "disagreement_fields"))).any? %>
          Chưa thống nhất: <%= fields.map { |field| t("extraction_fields.#{field}", default: { "document_count" => "Số chứng từ", "document_missing" => "Chứng từ bị thiếu", "merchant_catalog_identity" => "Hộ kinh doanh" }.fetch(field, field)) }.join(", ") %>.
        <% end %>
      </p>
    <% end %>
    <% if (ids = Array(transaction.source_data["possible_duplicate_ids"])).any? %>
      <div class="mt-2">
        <%= t("transactions.possible_duplicates") %>:
        <%= safe_join(ids.map { |id| link_to("##{id}", admin_transaction_path(id)) }, ", ") %>
      </div>
    <% end %>
  </div>
<% end %>
