<%# locals: (resource:, edit_path:, delete_path: nil, confirm: nil, extra: nil) %>
<%# The last cell of every configuration table: same actions, same look, same permission. %>
<td class="text-nowrap text-end w-1">
  <% if can?(:manage, resource) %>
    <div class="row-actions">
      <%= link_to edit_path, class: "btn btn-sm btn-ghost-secondary btn-icon", title: t("actions.edit"), aria: { label: t("actions.edit") } do %><%= icon("edit") %><% end %>
      <%= extra %>
      <% if delete_path %>
        <%= button_to delete_path, method: :delete, class: "btn btn-sm btn-ghost-danger btn-icon", title: t("actions.delete"), aria: { label: t("actions.delete") },
              form: { data: { turbo_confirm: confirm || t("actions.confirm_delete") } } do %>
          <%= icon("trash") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</td>
