<%# locals: (resource:, edit_path:, delete_path: nil, confirm: nil, extra: nil) %>
<%# The last cell of every configuration table: same actions, same look, same permission. %>
<td class="text-nowrap text-end w-1">
  <% if can?(:manage, resource) %>
    <div class="dropdown row-actions">
      <button type="button" class="btn btn-sm btn-ghost-secondary btn-icon" data-bs-toggle="dropdown"
              data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="<%= t("actions.more") %>">
        <%= icon("dots-vertical") %>
      </button>
      <div class="dropdown-menu dropdown-menu-end">
        <%= link_to edit_path, class: "dropdown-item" do %><%= icon("edit", "dropdown-item-icon") %> <%= t("actions.edit") %><% end %>
        <%= extra %>
        <% if delete_path %>
          <div class="dropdown-divider"></div>
          <%= button_to delete_path, method: :delete, class: "dropdown-item text-danger",
                form: { data: { turbo_confirm: confirm || t("actions.confirm_delete") } } do %>
            <%= icon("trash", "dropdown-item-icon") %> <%= t("actions.delete") %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</td>
