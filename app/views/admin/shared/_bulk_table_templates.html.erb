<template id="bulk-table-toolbar">
  <div class="bulk-toolbar" role="region" aria-label="<%= t('bulk.labels.toolbar') %>">
    <div class="bulk-selection-info">
      <strong data-bulk-count aria-live="polite"></strong>
      <span class="text-secondary small"><%= t("bulk.labels.page_only") %></span>
    </div>
    <div class="bulk-buttons">
      <button type="button" class="btn btn-sm btn-outline-secondary" data-bulk-export disabled><%= icon("download") %> <%= t("bulk.labels.export") %></button>
      <span class="bulk-mutations" data-bulk-operations></span>
      <button type="button" class="btn btn-sm btn-ghost-secondary" data-bulk-clear disabled><%= t("bulk.labels.clear") %></button>
    </div>
  </div>
</template>

<template id="bulk-table-dialog">
  <dialog class="rejection-dialog bulk-dialog">
    <form>
      <div class="card-header"><h2 class="card-title" data-bulk-title></h2></div>
      <div class="card-body">
        <p data-bulk-hint></p>
        <div data-bulk-note-group>
          <label class="form-label" data-bulk-note-label><%= t("transactions.rejection.reason") %></label>
          <p class="small text-secondary"><%= t("bulk.labels.shared_reason") %></p>
          <textarea class="form-control" rows="3" maxlength="2000" data-bulk-note></textarea>
        </div>
        <div data-bulk-result role="status" aria-live="polite" tabindex="-1" hidden></div>
      </div>
      <div class="card-footer d-flex justify-content-end gap-2">
        <button type="button" class="btn" data-bulk-cancel><%= t("actions.cancel") %></button>
        <button type="submit" class="btn btn-primary" data-bulk-confirm><%= t("bulk.labels.confirm") %></button>
      </div>
    </form>
  </dialog>
</template>
