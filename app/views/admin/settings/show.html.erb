<% content_for :title, t("navigation.settings_app") %>

<div class="row row-cards">
  <div class="col-lg-8">
    <% unless @services.fetch(AppConfig.vision_provider.to_sym, true) %>
      <div class="alert alert-danger"><%= icon("alert-triangle") %> <%= t("settings.ocr_not_working") %></div>
    <% end %>
    <div class="card mb-3" id="ket-noi">
      <div class="card-header">
        <div>
          <h3 class="card-title"><%= icon("plug-connected") %> <%= t("settings.connections.title") %></h3>
          <div class="text-secondary small"><%= t("settings.connections.help") %></div>
        </div>
      </div>
      <div class="card-body">
        <div class="d-flex align-items-center mb-2">
          <span class="fw-medium"><%= t("settings.telegram.token") %></span>
          <span class="ms-auto"><%= render "secret_badge", source: @telegram[:token], scope: "settings.telegram.token_sources" %></span>
        </div>
        <% if can?(:manage, :settings) %>
          <%= form_with url: telegram_token_admin_settings_path, method: :patch do |form| %>
            <div class="input-group">
              <%= form.password_field :telegram_bot_token, class: "form-control", required: true, autocomplete: "off",
                                      placeholder: t("settings.telegram.token_placeholder") %>
              <%= form.button t("actions.save"), class: "btn btn-primary", data: { turbo_submits_with: t("settings.telegram.checking") } %>
            </div>
            <small class="form-hint"><%= t("settings.telegram.token_hint") %></small>
          <% end %>
        <% end %>
      </div>
      <div class="card-body border-top">
        <div class="d-flex align-items-center mb-2">
          <span class="fw-medium"><%= t("settings.spreadsheet.label") %></span>
          <span class="ms-auto"><%= render "secret_badge", source: @spreadsheet[:source], scope: "settings.spreadsheet.sources" %></span>
        </div>
        <% if @spreadsheet[:id] %>
          <div class="small text-secondary mb-2 text-break">
            <code><%= @spreadsheet[:id] %></code>
            · <%= link_to t("settings.spreadsheet.open"), Workbook::Connection.url(@spreadsheet[:id]), target: "_blank", rel: "noopener" %>
          </div>
        <% end %>
        <% if can?(:manage, :settings) %>
          <%= form_with url: spreadsheet_admin_settings_path, method: :patch do |form| %>
            <div class="input-group">
              <%= form.text_field :spreadsheet_id, class: "form-control", required: true, autocomplete: "off", spellcheck: false,
                                  placeholder: t("settings.spreadsheet.placeholder") %>
              <%= form.button t("actions.save"), class: "btn btn-primary", data: { turbo_submits_with: t("settings.spreadsheet.checking") } %>
            </div>
            <small class="form-hint"><%= t("settings.spreadsheet.hint") %></small>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= form_with url: admin_settings_path, method: :patch, scope: :settings, html: { id: "van-hanh" } do |form| %>
      <% if @form.errors.any? %>
        <div class="alert alert-danger">
          <h4 class="alert-title"><%= t("forms.error_summary", count: @form.errors.count) %></h4>
          <ul class="mb-0"><% @form.errors.full_messages.uniq.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <% AppSetting::GROUPS.each do |group| %>
        <div class="card mb-3">
          <div class="card-header">
            <div>
              <h3 class="card-title"><%= icon(t("settings.group_icons.#{group}")) %> <%= t("settings.groups.#{group}") %></h3>
              <div class="text-secondary small"><%= t("settings.group_hints.#{group}") %></div>
            </div>
          </div>
          <div class="card-body">
            <div class="row">
              <% AppSetting::DEFINITIONS.values.select { |definition| definition.group == group }.each do |definition| %>
                <div class="col-12">
                  <%= render "field", form: form, definition: definition %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card">
        <div class="card-body settings-save">
          <span class="text-secondary small me-auto"><%= t("settings.apply_delay") %></span>
          <%= link_to t("actions.cancel"), admin_settings_path, class: "btn" %>
          <button type="submit" class="btn btn-primary"><%= icon("device-floppy") %> <%= t("actions.save") %></button>
          <% if @last_change %>
            <span class="text-secondary small ms-auto">
              <%= t("settings.last_change", user: @last_change.actor_name || t("audit_logs.system"), at: l(@last_change.created_at.in_time_zone, format: :short)) %>
              · <%= link_to t("actions.view"), admin_audit_log_path(@last_change) %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <% editable = can?(:manage, :settings) %>
    <details class="card mt-3" id="tinh-chinh" <%= "open" if @tuning_form.errors.any? || params[:action] == "tuning" %>>
      <summary class="card-header"><span class="card-title"><%= icon("adjustments") %> <%= t("settings.tuning.title") %></span></summary>
      <%= form_with url: tuning_admin_settings_path, method: :patch, scope: :tuning do |form| %>
        <div class="card-body small text-secondary"><%= t("settings.tuning.help") %></div>
        <% if @tuning_form.errors.any? %>
          <div class="card-body pt-0">
            <div class="alert alert-danger mb-0">
              <h4 class="alert-title"><%= t("forms.error_summary", count: @tuning_form.errors.count) %></h4>
              <ul class="mb-0"><% @tuning_form.errors.full_messages.uniq.each do |message| %><li><%= message %></li><% end %></ul>
            </div>
          </div>
        <% end %>
        <div class="table-responsive">
          <table class="table card-table table-sm table-vcenter">
            <thead>
              <tr>
                <th><%= t("settings.tuning.name") %></th>
                <th><%= t("settings.tuning.override") %></th>
                <th><%= t("settings.tuning.value") %></th>
                <th><%= t("settings.tuning.env") %></th>
                <th><%= t("settings.tuning.default") %></th>
              </tr>
            </thead>
            <tbody>
              <% @tuning.each do |row| %>
                <% key = row[:key] %>
                <% spec = row[:spec] %>
                <% invalid = @tuning_form.errors[key].any? %>
                <% fallback = row[:env_value] || spec[:default] %>
                <tr>
                  <td><label for="tuning_<%= key %>"><%= t("settings.keys.#{key}", default: key) %></label></td>
                  <td style="min-width: 11rem">
                    <% css = "form-control form-control-sm #{'is-invalid' if invalid}" %>
                    <% if spec[:type] == :boolean || spec[:options] %>
                      <% choices = spec[:options] || %w[true false] %>
                      <%= select_tag "tuning[#{key}]",
                            options_for_select([ [ t("settings.tuning.unset", value: fallback), "" ] ] + choices.map { |choice| [ choice, choice ] }, @tuning_form[key]),
                            class: "form-select form-select-sm #{'is-invalid' if invalid}", id: "tuning_#{key}", disabled: !editable %>
                    <% else %>
                      <%= text_field_tag "tuning[#{key}]", @tuning_form[key], class: css, id: "tuning_#{key}", placeholder: fallback,
                            autocomplete: "off", spellcheck: false, disabled: !editable,
                            inputmode: (%i[integer rate].include?(spec[:type]) ? "decimal" : nil) %>
                    <% end %>
                    <% if invalid %><div class="invalid-feedback d-block"><%= @tuning_form.errors[key].uniq.to_sentence %></div><% end %>
                  </td>
                  <td>
                    <code><%= row[:value].to_s.presence || "—" %></code>
                    <div class="small text-secondary"><%= t("settings.tuning.sources.#{row[:source]}") %></div>
                  </td>
                  <td>
                    <code><%= spec[:env] %></code>
                    <div class="small text-secondary text-break"><%= row[:env_value] || t("settings.tuning.env_unset") %></div>
                  </td>
                  <td><code><%= spec[:default] %></code></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if editable %>
          <div class="card-body settings-save">
            <span class="text-secondary small me-auto"><%= t("settings.apply_delay") %></span>
            <button type="submit" class="btn btn-primary"><%= icon("device-floppy") %> <%= t("actions.save") %></button>
          </div>
        <% end %>
      <% end %>
    </details>
  </div>

  <div class="col-lg-4">
    <div class="card mb-3" id="telegram">
      <div class="card-header">
        <div>
          <h3 class="card-title"><%= icon("brand-telegram") %> <%= t("settings.telegram.title") %></h3>
          <div class="text-secondary small"><%= t("settings.telegram.help") %></div>
        </div>
      </div>
      <div class="card-body">
        <div class="d-flex align-items-center mb-1">
          <span class="fw-medium"><%= t("settings.telegram.webhook") %></span>
          <span class="ms-auto"><%= render "secret_badge", source: @telegram[:webhook], scope: "settings.telegram.webhook_sources" %></span>
        </div>
        <div class="small text-secondary mb-2 text-break">
          <% if @telegram[:webhook_url] %><code><%= @telegram[:webhook_url] %></code><% else %><%= t("settings.telegram.app_host_missing") %><% end %>
        </div>
        <% if can?(:manage, :settings) %>
          <%= button_to telegram_webhook_admin_settings_path, class: "btn btn-outline-primary btn-sm",
                disabled: @telegram[:webhook_url].nil? || @telegram[:token].nil?,
                data: { turbo_submits_with: t("settings.telegram.registering") } do %>
            <%= icon("plug-connected") %> <%= t("settings.telegram.register_webhook") %>
          <% end %>
          <div class="small text-secondary mt-2"><%= t("settings.telegram.webhook_hint") %></div>
        <% end %>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <div>
          <h3 class="card-title"><%= icon("plug-connected") %> <%= t("settings.services.title") %></h3>
          <div class="text-secondary small"><%= t("settings.services.help") %></div>
        </div>
      </div>
      <table class="table card-table">
        <% @services.each do |service, configured| %>
          <tr>
            <td><%= t("settings.services.#{service}") %><div class="small text-secondary"><code><%= t("settings.services.env.#{service}") %></code></div></td>
            <td class="text-end">
              <% if configured %>
                <span class="badge bg-green-lt"><%= t("settings.services.configured") %></span>
              <% else %>
                <span class="badge bg-secondary-lt"><%= t("settings.services.missing") %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr>
          <td><%= t("settings.services.storage") %></td>
          <td class="text-end"><code><%= t("settings.services.storage_values.#{@storage_service}", default: @storage_service) %></code></td>
        </tr>
      </table>
      <% if can?(:manage, :settings) %>
        <div class="card-footer">
          <%= button_to check_r2_admin_settings_path, class: "btn btn-outline-primary btn-sm",
                data: { turbo_submits_with: t("settings.r2_check.submitting") } do %>
            <%= icon("cloud-check") %> <%= t("settings.r2_check.action") %>
          <% end %>
          <div class="small text-secondary mt-2"><%= t("settings.r2_check.help") %></div>
        </div>
      <% end %>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title"><%= t("navigation.card_types") %></h3>
        <div class="card-actions"><%= link_to t("actions.manage"), admin_card_types_path %></div>
      </div>
      <table class="table card-table">
        <% @card_types.each do |card_type| %>
          <tr><td><code><%= card_type.key %></code></td><td><%= card_type.name %></td><td><%= active_badge(card_type.active?) %></td></tr>
        <% end %>
      </table>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t("settings.tools") %></h3></div>
      <div class="list-group list-group-flush">
        <% if current_user.admin? %>
          <a href="/admin/sidekiq" class="list-group-item list-group-item-action" target="_blank" rel="noopener"><%= icon("server-cog") %> <%= t("settings.sidekiq") %></a>
        <% end %>
        <a href="/health" class="list-group-item list-group-item-action" target="_blank" rel="noopener"><%= icon("heartbeat") %> <%= t("settings.health") %></a>
      </div>
    </div>
  </div>
</div>
