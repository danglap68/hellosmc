<% content_for :title, @dealer.name %>
<% content_for :breadcrumbs do %>
  <li class="breadcrumb-item"><%= link_to t("navigation.dealers"), admin_dealers_path %></li>
  <li class="breadcrumb-item active"><%= @dealer.name %></li>
<% end %>
<% content_for :actions do %>
  <% if can?(:manage, :dealers) %>
    <%= link_to edit_admin_dealer_path(@dealer), class: "btn" do %><%= icon("edit") %> <%= t("actions.edit") %><% end %>
    <%= button_to admin_dealer_path(@dealer), method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: t("actions.confirm_delete") } } do %><%= icon("trash") %> <%= t("actions.delete") %><% end %>
  <% end %>
<% end %>

<div class="row row-cards">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5"><%= Dealer.human_attribute_name(:code) %></dt><dd class="col-7"><code><%= @dealer.code %></code></dd>
          <dt class="col-5"><%= Dealer.human_attribute_name(:default_card_type) %></dt><dd class="col-7"><%= @dealer.default_card_type&.name || "—" %></dd>
          <dt class="col-5"><%= Dealer.human_attribute_name(:active) %></dt><dd class="col-7"><%= active_badge(@dealer.active?) %></dd>
        </dl>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title"><%= icon("building-store") %> <%= t("dealers.merchants") %></h3>
      </div>
      <% if @merchants.any? %>
        <div class="table-responsive">
          <table class="table card-table table-vcenter" <%= bulk_table_attributes(:merchants) %>>
            <% @merchants.each do |merchant| %>
              <tr <%= bulk_row_attributes(merchant) %>><td><%= link_to merchant.name, admin_merchant_path(merchant) %></td><td><code><%= merchant.code %></code></td><td><%= safe_join(Array(@tids_by_merchant[merchant.id]).map { |link| content_tag(:span, link.tid_label, class: "badge bg-blue-lt me-1") }) %></td><td><%= active_badge(merchant.active?) %></td></tr>
            <% end %>
          </table>
        </div>
      <% else %>
        <div class="card-body text-secondary"><%= t("merchants.index.empty") %></div>
      <% end %>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title"><%= icon("percentage") %> <%= t("navigation.fee_rules") %></h3>
        <% if can?(:manage, :fee_rules) %><div class="card-actions"><%= link_to t("fee_rules.index.new"), new_admin_fee_rule_path(dealer_id: @dealer.id) %></div><% end %>
      </div>
      <%= render "admin/fee_rules/table", fee_rules: @fee_rules %>
    </div>
  </div>
</div>
