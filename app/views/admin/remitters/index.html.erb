<% content_for :title, t("remitters.index.title") %>
<% content_for :actions do %>
  <% if can?(:manage, :remitters) %>
    <%= link_to new_admin_remitter_path, class: "btn btn-primary" do %><%= icon("plus") %> <%= t("remitters.index.new") %><% end %>
  <% end %>
<% end %>

<%= list_toolbar(
      url: admin_settings_organization_remitters_path,
      search: { param: "q", value: params[:q], placeholder: t("remitters.index.title") },
      default_sort: "oldest",
      sorts: [
        { key: "oldest", label: t("toolbar.sorts.oldest") },
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "name_asc", label: t("toolbar.sorts.name_asc") },
        { key: "name_desc", label: t("toolbar.sorts.name_desc") }
      ],
      filters: [
        { type: :single, name: "active", label: t("toolbar.active_state"), value: params[:active], options: [[t("common.active"), "1"], [t("common.inactive"), "0"]] }
      ]
    ) %>

<div class="card">
  <% if @remitters.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table" <%= bulk_table_attributes(:remitters) %>>
        <thead>
          <tr>
            <th><%= Remitter.human_attribute_name(:name) %></th>
            <th><%= Remitter.human_attribute_name(:excel_key) %></th>
            <th><%= Remitter.human_attribute_name(:telegram_user_id) %></th>
            <th><%= Remitter.human_attribute_name(:telegram_username) %></th>
            <th><%= Remitter.human_attribute_name(:active) %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% @remitters.each do |remitter| %>
            <tr <%= bulk_row_attributes(remitter) %>>
              <td><%= remitter.name %></td>
              <td><code><%= remitter.excel_key %></code></td>
              <td><code><%= remitter.telegram_user_id %></code></td>
              <td><code><%= remitter.telegram_username %></code></td>
              <td><%= active_badge(remitter.active?) %></td>
              <%= render "admin/shared/row_actions", resource: :remitters, edit_path: edit_admin_remitter_path(remitter),
                         delete_path: admin_remitter_path(remitter) %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("remitters.index.empty") %></div>
  <% end %>
</div>
