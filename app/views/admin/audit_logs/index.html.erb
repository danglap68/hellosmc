<% content_for :title, t("audit_logs.index.title") %>

<%= list_toolbar(
      url: admin_settings_system_audit_logs_path,
      search: { param: "q", value: params[:q], placeholder: t("audit_logs.index.title") },
      default_sort: "newest",
      sorts: [
        { key: "newest", label: t("toolbar.sorts.newest") },
        { key: "oldest", label: t("toolbar.sorts.oldest") }
      ],
      filters: [
        { type: :single, name: "actor", label: t("audit_logs.filters.actor"), value: params[:actor], options: [[t("audit_logs.system"), "system"]] + @users.map { |user| [user.display_name, user.id] } },
        { type: :single, name: "entity", label: t("audit_logs.filters.entity"), value: params[:entity], options: @entities.map { |entity| [auditable_label(entity), entity] } },
        { type: :single, name: "action_name", label: t("audit_logs.filters.action"), value: params[:action_name], options: @actions.map { |action| [audit_action_label(action), action] } },
        { type: :date_range, key: "dates", label: AuditLog.human_attribute_name(:created_at), from_name: "date_from", to_name: "date_to", from_value: params[:date_from], to_value: params[:date_to] }
      ]
    ) %>

<div class="card">
  <% if @audit_logs.any? %>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead>
          <tr>
            <th><%= AuditLog.human_attribute_name(:created_at) %></th>
            <th><%= AuditLog.human_attribute_name(:actor) %></th>
            <th><%= AuditLog.human_attribute_name(:action) %></th>
            <th><%= AuditLog.human_attribute_name(:auditable) %></th>
            <th><%= t("audit_logs.changed_fields") %></th>
            <th class="w-1"></th>
          </tr>
        </thead>
        <tbody>
          <% @audit_logs.each do |log| %>
            <tr>
              <td class="text-nowrap"><%= format_datetime(log.created_at) %></td>
              <td><%= audit_actor(log) %></td>
              <td><%= audit_action_label(log.action) %></td>
              <td><%= log.auditable_type ? "#{auditable_label(log.auditable_type)} ##{log.auditable_id}" : "—" %></td>
              <td class="small text-secondary"><%= log.before_data.present? ? log.changed_keys.first(5).join(", ") : "" %></td>
              <td><%= link_to admin_audit_log_path(log), class: "btn btn-sm btn-ghost-secondary btn-icon", title: t("actions.view"), aria: { label: t("actions.view") } do %><%= icon("eye") %><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= pagination(@pagy) %>
  <% else %>
    <div class="card-body"><%= empty_state t("audit_logs.index.empty"), nil, icon_name: "history" %></div>
  <% end %>
</div>
