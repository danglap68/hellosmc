<% hours = (Devise.reset_password_within / 1.hour).round %>
<% url = edit_password_url(@resource, reset_password_token: @token) %>
<% content_for :preheader, t(".preheader", hours: hours) %>

<%= email_heading t(".heading") %>
<%= email_paragraph t("mailer.hello", name: @resource.display_name) %>
<%= email_paragraph t(".intro_html", email: @resource.email, app: t("app.name")) %>
<%= email_button t(".cta"), url %>
<%= email_note t(".expiry", hours: hours) %>
<%= email_paragraph t(".ignore") %>
<%= email_link_fallback url %>
