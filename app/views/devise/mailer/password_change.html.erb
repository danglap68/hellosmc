<% content_for :preheader, t(".preheader") %>

<%= email_heading t(".heading") %>
<%= email_paragraph t("mailer.hello", name: @resource.display_name) %>
<%= email_paragraph t(".message_html", email: @resource.email, app: t("app.name"), time: l(Time.current, format: :short)) %>
<%= email_note t(".warning"), tone: :warning %>
