<% hours = (Devise.reset_password_within / 1.hour).round %>
<%= t("mailer.hello", name: @resource.display_name) %>

<%= strip_tags(t(".intro_html", email: @resource.email, app: t("app.name"))) %>

<%= t(".cta") %>: <%= edit_password_url(@resource, reset_password_token: @token) %>

<%= t(".expiry", hours: hours) %>

<%= t(".ignore") %>
