<% content_for :title, t(".change_your_password") %>
<div class="card card-md">
  <div class="card-body">
    <h1 class="auth-title mb-4"><%= t(".change_your_password") %></h1>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div class="mb-3">
        <%= f.label :password, t(".new_password"), class: "form-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
        <% if @minimum_password_length %>
          <small class="form-hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></small>
        <% end %>
      </div>
      <div class="mb-3">
        <%= f.label :password_confirmation, t(".confirm_new_password"), class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
      </div>
      <div class="form-footer">
        <button type="submit" class="btn btn-primary w-100"><%= t(".change_my_password") %></button>
      </div>
    <% end %>
  </div>
</div>
